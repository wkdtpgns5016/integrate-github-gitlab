# cp .env.example .env 후 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)
# 값에 공백/특수문자가 있으면 따옴표로 감싸세요.

# ── GitHub ────────────────────────────────────────────────
# 미러링할 GitHub 레포지토리 (owner/repo). gh 로 시크릿/변수를 등록할 대상이기도 함.
GITHUB_REPO=owner/repo

# gh CLI 인증에 사용할 GitHub Personal Access Token ('gh auth login' 을 생략하기 위함).
# https://github.com/settings/tokens 에서 발급하세요.
#   - classic 토큰: repo 스코프 (시크릿/변수 등록에 필요)
#   - fine-grained 토큰: 대상 레포에 Secrets(RW), Variables(RW), Contents(Read) 권한
GITHUB_PAT=your_github_pat

# ── GitLab ────────────────────────────────────────────────
# GitHub Actions 러너(Tailscale 로 접속)가 GitLab 에 접근할 때 쓰는 호스트.
# 이 GitLab 을 실행하는 머신의 Tailscale IP 또는 MagicDNS 이름 (포트는 GITLAB_HTTP_PORT 로 따로 지정).
# 예) 100.64.0.10 / my-mac.tailnet-name.ts.net
# TAILSCALE_HOST_AUTHKEY 를 채우면 up.sh 가 이 값을 자동으로 채워줍니다 (직접 안 적어도 됨).
GITLAB_HOST=

# GitLab 웹/git(HTTP) 을 노출할 호스트 포트. 기본값 8088.
# Tailscale 인터페이스에도 그대로 바인딩되므로 포트포워딩은 필요 없습니다.
GITLAB_HTTP_PORT=8088

# root 초기 비밀번호 (최초 기동 시에만 적용, 8자 이상)
GITLAB_ROOT_PASSWORD=your_password_here

# 생성할 빈 프로젝트 이름. 비우면 GITHUB_REPO 의 repo 이름을 사용. (root/<이름> 으로 생성)
GITLAB_PROJECT_NAME=

# ── Tailscale ─────────────────────────────────────────────
# 두 키는 용도가 다릅니다. https://login.tailscale.com/admin/settings/keys 에서 각각 발급하세요.
#
# 이 GitLab 머신 자체를 tailnet 에 영구 조인시킬 때 쓰는 key.
# ⚠️ 'Ephemeral' 은 반드시 꺼서 발급하세요. 켜면 연결이 끊길 때 디바이스가 자동 삭제됩니다.
# ⚠️ 'Reusable' 은 켜서 발급하세요. up.sh 는 재실행할 때마다 매번 이 key 로 `tailscale up` 을
#    다시 시도해서 조인 상태를 갱신합니다(관리 콘솔에서 디바이스를 수동으로 지운 뒤 재실행해도
#    자동으로 재등록되게 하려는 목적). 1회용 key 로 발급하면 두 번째 실행부터 인증이 실패합니다.
# 채워두면 up.sh 가 Tailscale 설치(macOS/Linux 자동 감지) + 조인 + GITLAB_HOST 자동 입력까지 처리합니다.
# 비워두면 Tailscale 자동화를 건너뛰고 GITLAB_HOST 를 직접 관리해야 합니다.
TAILSCALE_HOST_AUTHKEY=

# GitHub Actions 워크플로가 매 실행마다 tailnet 에 임시로 접속할 때 쓰는 OAuth client.
# (정적 auth key는 tailscale/github-action 에서 deprecated 되어 OAuth client 방식을 씁니다.)
# https://login.tailscale.com/admin/settings/oauth 에서 발급하세요.
#   - Scopes: "Auth Keys" Write
#   - Tags: tag:ci (아래 워크플로의 `tags: tag:ci` 와 일치해야 함 — OAuth client 로 만든 key 는
#     태그 없는 디바이스를 못 만듭니다)
# 그리고 tailnet ACL 정책(Access Controls)에 태그 소유자를 등록해야 합니다. 예:
#   "tagOwners": { "tag:ci": ["autogroup:admin"] }
# 이 값을 채워야 GitHub 시크릿 TS_OAUTH_CLIENT_ID/TS_OAUTH_CLIENT_SECRET 으로 등록됩니다. 비워두면 등록을 건너뜁니다.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

# ── 선택 ──────────────────────────────────────────────────
# GITLAB_VERSION=19.4.0-ce.0
# 러너는 GitLab 과 같은 버전(v 접두사)으로 맞추는 걸 권장합니다. GITLAB_VERSION 을 바꾸면 이 값도 맞춰주세요.
# GITLAB_RUNNER_VERSION=v19.4.0
# GITLAB_WAIT_TIMEOUT=1200
